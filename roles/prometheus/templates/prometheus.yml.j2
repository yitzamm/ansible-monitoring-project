global:
  scrape_interval: 5s

scrape_configs:
  # Prometheus se monitorea a si mismo
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # El API: Prometheus consulta su endpoint /metrics cada 5s
  - job_name: demo-api
    metrics_path: /metrics
    static_configs:
      - targets: ["{{ api_container }}:8000"]